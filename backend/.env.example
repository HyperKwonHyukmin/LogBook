# Hi-TESS LogBook 백엔드 환경 변수 — 이 파일을 .env 로 복사해 값을 채운다 (.env 는 커밋 금지)
LOGBOOK_DB_USER=logbook_app
LOGBOOK_DB_PASSWORD=
LOGBOOK_DB_HOST=localhost
LOGBOOK_DB_PORT=3306
LOGBOOK_DB_NAME=logbook
# 원본 저장소(공유 폴더). 개발 중 로컬 폴더로 바꿔도 된다.
LOGBOOK_STORAGE_ROOT=\\storage.hpc.hd.com\a476854\00_PROJECT\AA_300_CF44\999_LogBook
LOGBOOK_SESSION_HOURS=8
# 05 운영(비우면 기본값) — mysqldump 경로·바로가기 주소·백업 보관 개수·휴지통 보관일·일일 작업 시각(시)
LOGBOOK_MYSQLDUMP=C:\Program Files\MySQL\MySQL Server 8.0\bin\mysqldump.exe
LOGBOOK_PUBLIC_URL=http://10.14.42.145:9095
LOGBOOK_BACKUP_KEEP=30
LOGBOOK_TRASH_DAYS=90
LOGBOOK_DAILY_HOUR=2
# 15 — WorkBench 사용자 표(읽기 전용, 스키마.표). logbook 계정에 GRANT SELECT 필요. 활성 여부 캐시(초)
LOGBOOK_WB_USERS_TABLE=hitessworkbench.users
LOGBOOK_WB_CACHE_SECONDS=60
# 18 — WorkBench 연동. 비밀키는 WorkBench 쪽 LOGBOOK_INTEGRATION_SECRET 과 같은 값(비우면 연동이 꺼져 WorkBench 가 404 를 받는다)
LOGBOOK_WB_INTEGRATION_SECRET=
# LOGBOOK_WB_API_URL=http://127.0.0.1:9091
# 06 — 해석 검증. Nastran 실행 파일(비우면 PATH 의 nastran → 기본 설치 경로)·시간 제한(초)
# LOGBOOK_NASTRAN_EXE=
# LOGBOOK_SOLVE_TIMEOUT=1800
# 파일 하나의 본문 추출·BDF 변환 제한(초). 워커가 자식 프로세스에서 돌리고 넘으면 끝내 실패 처리한다(0 = 제한 없이 워커 안에서)
# LOGBOOK_EXTRACT_TIMEOUT=600
# LOGBOOK_CONVERT_TIMEOUT=1800
# 화면 빌드 폴더(기본 frontend\dist)
# LOGBOOK_FRONTEND_DIST=
# 17 — 업로드 마무리 때 '완전 동일 BDF' 를 바로 검사하는 상한(한 업로드의 모델 바이트 합·경과 초). 넘으면 워커가 검사한다
LOGBOOK_DUP_SYNC_MAX_BYTES=33554432
LOGBOOK_DUP_SYNC_SECONDS=15
# 22 — 보고서 본문 색인(비우면 기본값, 전체 목록은 ops/README.md 13-4). 색인은 로컬 디스크, OCR 언어 데이터 폴더(기본 Tesseract 설치 폴더\tessdata)
# LOGBOOK_REPORT_INDEX_PATH=
# LOGBOOK_REPORT_TESSDATA=
# LOGBOOK_REPORT_OLLAMA_URL=http://127.0.0.1:11434
# LOGBOOK_REPORT_RAG_CONCURRENCY=2
# 보고서 한 건 추출(OCR 포함) 전체 제한(초, 0 = 제한 없음)
# LOGBOOK_REPORT_EXTRACT_TIMEOUT=3600
# 30 — 사내 PLM(VT_PLM_SHIP) 호선 선박 정보 조회. WorkBench .env 와 같은 키·값을 그대로 옮기면 된다(모두 비우면 기능 꺼짐).
# PLM_ORACLE_DSN=
# PLM_ORACLE_USER=
# PLM_ORACLE_PASSWORD=
# 10G password verifier 서버는 thick mode 필요 — Oracle Client(Instant Client) 폴더
# PLM_ORACLE_LIB_DIR=
# 별칭(HIPLM)을 풀 tnsnames.ora 폴더 — WorkBench .env 의 TNS_ADMIN 과 같게(없으면 다른 tnsnames 의 옛 주소로 가 ORA-12541)
# TNS_ADMIN=
